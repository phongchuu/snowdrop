####### Docker ENV #######
# Postgres
POSTGRES_DB_SUPER_USER=<super_user_name>
POSTGRES_DB_SUPER_PASSWORD=<super_user_password>
POSTGRES_DB_FORWARD_PORT=5432
SNOWDROP_DB_NAME=<snowdrop_db_name>
SNOWDROP_DB_ADMIN_USER=<snowdrop_db_admin_user>
SNOWDROP_DB_ADMIN_PASSWORD=<snowdrop_db_admin_password>

# PG4Admin
PGADMIN_EMAIL=snowdrop-admin@local.com
PGADMIN_PASSWORD=<pg4admin_password>
PGADMIN_FORWARD_PORT=8080

####### Application ENV #######
APP_DB_HOST=localhost
APP_DB_PORT=${POSTGRES_DB_FORWARD_PORT}
APP_DB_NAME=${SNOWDROP_DB_NAME}
APP_DB_USERNAME=${SNOWDROP_DB_ADMIN_USER}
APP_DB_PASSWORD=${SNOWDROP_DB_ADMIN_PASSWORD}
APP_DEFAULT_SYSTEM_PASSWORD=<app_default_system_password>
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
